# ─────────────────────────────────────────────────────────────────────
# Copy to .env and replace every REQUIRED value before deploying.
#   cp .env.production.example .env
# Generate secrets:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────

# Public URL of this deployment. MUST be https in production.
BASE_URL=https://links.example.com
# Browser origin; keep equal to BASE_URL when nginx serves both app + API.
APP_URL=https://links.example.com
# Optional comma-separated extra origins allowed by CORS.
CORS_ORIGINS=

# ─── Required secrets ────────────────────────────────────────────────
# 32+ random characters. Used by the dashboard and management API.
ADMIN_API_KEY=REPLACE_WITH_openssl_rand_hex_32
# 32+ random characters. Signs OAuth state cookies (required in production).
SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32
# Strong database password (12+ chars).
PGPASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# Strong Redis password (12+ chars).
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ─── Accounts & sessions ─────────────────────────────────────────────
SESSION_TTL_DAYS=30
# Must remain false in production; the process refuses to start otherwise.
AUTH_DEV_LOGIN=false
# Set true only after SMTP_HOST is configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_MIN_LENGTH=10

# OAuth apps — leave both values blank to hide that provider's button.
# Authorized callback URLs:
#   https://links.example.com/api/auth/oauth/google/callback
#   https://links.example.com/api/auth/oauth/github/callback
OAUTH_CALLBACK_BASE=https://links.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email for verification and password reset. Configure SMTP in
# production: without it no email is sent and tokens are never written to logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Shortly <no-reply@links.example.com>

# ─── Optional ────────────────────────────────────────────────────────
PGUSER=urlshortener
PGDATABASE=urlshortener
PG_POOL_MIN=2
PG_POOL_MAX=20

# Metrics: leave private unless you set a token or METRICS_PUBLIC=true.
METRICS_TOKEN=
METRICS_PUBLIC=false

# Redis memory ceiling for the cache (streams are not evicted by volatile-lru).
REDIS_MAXMEMORY=256mb

# PostgreSQL tuning (raise on larger hosts).
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB

# Exposed only on 127.0.0.1 by default; Cloudflare Tunnel reaches nginx internally.
EDGE_PORT=8080

# Cloudflare Tunnel token (only needed with `--profile tunnel`).
TUNNEL_TOKEN=

# Rate limits (requests per window, per client IP).
RATE_LIMIT_SHORTEN_MAX=20
RATE_LIMIT_REDIRECT_MAX=1200
RATE_LIMIT_MANAGE_MAX=240
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=300000

LOG_LEVEL=info
