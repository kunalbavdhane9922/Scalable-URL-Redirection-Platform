# ─────────────────────────────────────────────────────────────────────
# Local development sample. Copy to `backend/.env` for `npm dev`.
# For the Docker production stack use `.env.production.example` instead.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000
APP_URL=http://localhost:5173
TRUST_PROXY=true
LOG_LEVEL=debug

# Development-only admin key (production refuses this value).
ADMIN_API_KEY=dev-admin-key
METRICS_PUBLIC=true

# ─── Accounts & sessions ─────────────────────────────────────────────
# Signs OAuth state cookies. Any 32+ random characters are fine locally.
SESSION_SECRET=dev-session-secret-0123456789abcdef0123456789
SESSION_TTL_DAYS=30
# Local-only sign-in provider. Production refuses to boot with this enabled.
AUTH_DEV_LOGIN=true
AUTH_REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_MIN_LENGTH=10

# OAuth apps (leave blank to hide the buttons). Callback URLs:
#   Google: http://localhost:3000/api/auth/oauth/google/callback
#   GitHub: http://localhost:3000/api/auth/oauth/github/callback
OAUTH_CALLBACK_BASE=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP is optional in development; emails are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Shortly <no-reply@localhost>

PGHOST=localhost
PGPORT=5432
PGUSER=urlshortener
PGPASSWORD=dev-password
PGDATABASE=urlshortener
PG_POOL_MIN=2
PG_POOL_MAX=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

L1_MAX_ENTRIES=20000
L1_DEFAULT_TTL_MS=60000
L2_DEFAULT_TTL_SECONDS=3600

SHORT_CODE_LENGTH=7
ALIAS_MIN_LENGTH=3
ALIAS_MAX_LENGTH=32

RATE_LIMIT_SHORTEN_MAX=20
RATE_LIMIT_SHORTEN_WINDOW_MS=60000
RATE_LIMIT_REDIRECT_MAX=1200
RATE_LIMIT_REDIRECT_WINDOW_MS=60000
RATE_LIMIT_MANAGE_MAX=240
RATE_LIMIT_MANAGE_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=300000

MAX_URL_LENGTH=2048
ALLOWED_SCHEMES=http,https

QUEUE_STREAM_KEY=url_shortener:events
QUEUE_CONSUMER_GROUP=workers
QUEUE_CONSUMER_NAME=worker-1
QUEUE_BATCH_SIZE=100
QUEUE_MAX_RETRIES=3
CLICK_BUFFER_MAX_BATCH=250
CLICK_BUFFER_FLUSH_MS=100
