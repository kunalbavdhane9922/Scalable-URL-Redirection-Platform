# ─── Application ──────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=urlshortener
PGPASSWORD=changeme_pg_password
PGDATABASE=urlshortener

# Connection pool sizing (tune based on instance count and load testing)
PG_POOL_MIN=2
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# ─── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000

# ─── L1 Cache ────────────────────────────────
L1_MAX_ENTRIES=10000
L1_DEFAULT_TTL_MS=60000
L1_NEGATIVE_TTL_MS=30000
L1_NEGATIVE_MAX_ENTRIES=5000

# ─── L2 (Redis) Cache ────────────────────────
L2_DEFAULT_TTL_SECONDS=3600
L2_NEGATIVE_TTL_SECONDS=60
L2_TTL_JITTER_PERCENT=10

# ─── Short Code ───────────────────────────────
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_RETRIES=5

# ─── Rate Limiting ────────────────────────────
RATE_LIMIT_SHORTEN_MAX=10
RATE_LIMIT_SHORTEN_WINDOW_MS=60000
RATE_LIMIT_REDIRECT_MAX=100
RATE_LIMIT_REDIRECT_WINDOW_MS=60000

# ─── URL Validation ──────────────────────────
MAX_URL_LENGTH=2048
ALLOWED_SCHEMES=http,https

# ─── Queue (Redis Streams) ───────────────────
QUEUE_STREAM_KEY=url_shortener:events
QUEUE_CONSUMER_GROUP=workers
QUEUE_CONSUMER_NAME=worker-1
QUEUE_BATCH_SIZE=10
QUEUE_BLOCK_MS=5000
QUEUE_MAX_RETRIES=3

# ─── Logging ──────────────────────────────────
LOG_LEVEL=info
