{
  "name": "url-shortener-backend",
  "version": "1.0.0",
  "description": "Low-latency, horizontally scalable URL shortening service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/worker.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/integration",
    "loadtest": "node ../scripts/load-test.js"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "pg": "^8.13.1",
    "ioredis": "^5.4.1",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "lru-cache": "^11.0.2",
    "nanoid": "^5.0.9",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
